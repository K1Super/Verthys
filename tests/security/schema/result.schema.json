{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://verthys.local/schema/security-result-v1.json",
  "title": "Verthys security test result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "timestamp",
    "profile",
    "suite",
    "mode",
    "metadata",
    "summary",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 8
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "profile": {
      "enum": ["dev", "standard", "release", "baseline"]
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "gitDirty",
        "osBuild",
        "powershell",
        "dllSha256",
        "workerSha256",
        "serviceSha256",
        "registrySha256"
      ],
      "properties": {
        "gitCommit": { "type": ["string", "null"] },
        "gitDirty": { "type": ["boolean", "null"] },
        "osBuild": { "type": "string" },
        "powershell": { "type": "string" },
        "dllSha256": { "type": ["string", "null"] },
        "workerSha256": { "type": ["string", "null"] },
        "serviceSha256": { "type": ["string", "null"] },
        "registrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "skip", "blocked", "error", "notRun", "requiredFailures", "behavioral", "static", "evidence", "control"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "requiredFailures": { "type": "integer", "minimum": 0 },
        "behavioral": { "type": "integer", "minimum": 0 },
        "static": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "integer", "minimum": 0 },
        "control": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "legacyId",
          "name",
          "suite",
          "severity",
          "requirement",
          "kind",
          "status",
          "expected",
          "observed",
          "evidence",
          "durationMs",
          "executorExit"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "legacyId": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1 },
          "suite": { "enum": ["vault", "service", "tpm"] },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "requirement": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["behavioral", "static", "evidence", "control"] },
          "status": { "enum": ["PASS", "FAIL", "SKIP", "BLOCKED", "ERROR", "NOT_RUN"] },
          "expected": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "evidence": { "type": ["string", "null"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "executorExit": { "type": ["integer", "null"] }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
