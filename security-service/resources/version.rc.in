#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERTHYS_FILEVERSION@
 PRODUCTVERSION @VERTHYS_FILEVERSION@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Verthys"
            VALUE "FileDescription", "@VERTHYS_FILE_DESC@"
            VALUE "FileVersion", "@VERTHYS_VERSION_LINE@"
            VALUE "InternalName", "@VERTHYS_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@VERTHYS_ORIGINAL_NAME@"
            VALUE "ProductName", "Verthys"
            VALUE "ProductVersion", "@VERTHYS_VERSION_LINE@"
            VALUE "ProtocolVersion", "@VERTHYS_PROTOCOL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
