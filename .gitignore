# Build output (root-anchored: keep nested source dirs such as scripts/build trackable)
/build/
/build_dev/
/build_*/
/out/
/cmake-build-*/

# Rust build output
target/

# App runtime data (WebView cache, local databases)
verthys-tauri/appdata/

# Build/test logs and one-off diagnostics
*.log
*.err
*.out
*.tmp
test_out.txt
tmp_*.ps1
malware_hashes.txt

# vcpkg
vcpkg_installed/

# IDE
.vs/
.vscode/
.trae/
*.user

# Compiled
*.dll
*.exe
*.lib
*.obj
*.pdb
*.exp
*.ilk

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.idx_cache
*.verthys.d/

# 安装器资源由生产构建脚本生成
verthys-tauri/src-tauri/service-payload/

# 打包素材清单由 build_dev.ps1 / build_production.ps1 生成
/verthys-tauri/src-tauri/bundle-assets.json

# Python 缓存
__pycache__/
*.pyc

