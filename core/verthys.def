; verthys.def — DLL 导出定义
; 本文件是 DLL 导出符号的唯一白名单。
;   verthys.h 的 VERTHYS_API 宏不再携带 dllexport 语义，
;   未列入本文件的内部接口一律不可达。
;   Verthys_HasRecordByType / Verthys_FindFirstLidByType 为运行中 worker
;   实际消费的接口（verthys-worker/src/runtime/worker.rs:729,748），依
;   "关联模块最高标准同步"条款补录进白名单。
;   Verthys_GetSecurityStatus：
;   动态防护 7 路径状态查询。
LIBRARY verthys
EXPORTS
    Verthys_Init
    Verthys_NotifySandboxAttrs
    Verthys_Deinit
    Verthys_V4Create
    Verthys_V4CreateKeyfile
    Verthys_V4Unlock
    Verthys_V4UnlockKeyfile
    Verthys_V4UnlockRecovery
    Verthys_V4KeyfileEnable
    Verthys_V4KeyfileDisable
    Verthys_V4KeyfileStatus
    Verthys_V4ResealDevice
    Verthys_V4PcrStatus
    Verthys_V4PcrEnable
    Verthys_V4PcrDisable
    Verthys_V4PcrReseal
    Verthys_V4ChunkSeal
    Verthys_V4ChunkOpen
    Verthys_V4ModuleEnable
    Verthys_V4ModuleUnlock
    Verthys_V4ModuleLock
    Verthys_V4ModuleRotatePassword
    Verthys_V4ModuleDisable
    Verthys_V4ModuleDelete
    Verthys_V4ModuleBindRecovery
    Verthys_V4ModuleResealDevice
    Verthys_V4ModuleStatus
    Verthys_V4ModuleLockoutRemaining
    Verthys_GetLibLockoutRemaining
    Verthys_V4RecoveryRotate
    Verthys_V4RotateBegin
    Verthys_V4RotateAttachKeyfile
    Verthys_V4RotateUnlockModule
    Verthys_V4RotateRun
    Verthys_V4RotateCommit
    Verthys_V4RotateAbort
    Verthys_SwitchSecurityPreset
    Verthys_GetSecurityPreset
    Verthys_GetPresetFeatureBits
    Verthys_Lock
    Verthys_AddRecord
    Verthys_AddRecords
    Verthys_GetRecord
    Verthys_ClearRecordCache
    Verthys_DeleteRecord
    Verthys_DeleteRecords
    Verthys_Export
    Verthys_Import
    Verthys_ChangePassword
    Verthys_ScanOpen
    Verthys_ScanOpenEx
    Verthys_ScanFetch
    Verthys_ScanRecordFree
    Verthys_ScanClose
    Verthys_ScanSummaryOpen
    Verthys_ScanSummaryFetch
    Verthys_ScanSummaryRecordFree
    Verthys_GetSummaryCount
    Verthys_HasRecordByType
    Verthys_FindFirstLidByType
    Verthys_ListIdsByType
    Verthys_Flush
    Verthys_GetContainerInfo
    Verthys_VerifyIntegrity
    Verthys_GetDiagnostics
    Verthys_GetSecurityStatus
    Verthys_NotifyRuntimeGuards
    Verthys_VerifyPersist
